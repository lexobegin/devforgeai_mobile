# ============================================================
# DevForge AI Mobile — Variables de entorno (Ciclo 2, app informativa)
# ============================================================
# La app NO usa flutter_dotenv: estas variables se pasan en tiempo de
# compilación con --dart-define (ver lib/core/config/env.dart):
#
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.5:8000/api/v1
#
# Los valores por defecto están en env.dart; este archivo documenta qué
# se puede definir y con qué valores de ejemplo.
# ============================================================

# --- Backend API (REST, obligatorio apuntar al backend real) ---
# Emulador Android:  10.0.2.2 es el alias del host local.
# Dispositivo físico: usa la IP de la máquina de desarrollo.
# Producción:         https://api-devforgeai.duckdns.org/api/v1 (por defecto).
API_BASE_URL=http://10.0.2.2:8000/api/v1

# --- Modo de operación (development | production | test) ---
APP_ENV=development

# --- Timeouts HTTP (ms) ---
API_TIMEOUT_MS=30000

# --- Versionado (se muestra en Perfil) ---
APP_VERSION=0.3.0

# ============================================================
# Push FCM (AMPLIACIÓN OPCIONAL — no implementada)
# ============================================================
# El plan D33 define la observación móvil por REST (sondeo 30 s) +
# aviso push. El push requiere proyecto Firebase, google-services.json
# y las dependencias firebase_core/firebase_messaging. Si se aprueba,
# se añadirían aquí las claves del proyecto.
